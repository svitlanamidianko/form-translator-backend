# Environment Variables for Form Translator Backend
# Copy this file to .env and fill in your actual values

# Flask Configuration
SECRET_KEY=your-secret-key-here
DEBUG=true
FLASK_ENV=development

# OpenAI API Configuration
OPENAI_API_KEY=your-openai-api-key-here

# Which OpenAI models to use (these are the defaults - you only need to set them to change something)
# Text model for translation, form detection, auto-grouping and photo captions
OPENAI_MODEL=gpt-5.6-luna
# none | low | medium | high | xhigh | max  (leave EMPTY or write "off" for models that don't support reasoning)
OPENAI_REASONING_EFFORT=low
# Photo "translation" (POST /translate-image)
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
# low | medium | high | xhigh | max | auto  (higher = prettier but slower and more expensive)
OPENAI_IMAGE_QUALITY=low

# Cost protection for photo translations
# (the per-visitor hour is counted in memory and starts fresh after a restart;
#  the daily count is re-read from the interest_registered tab after every restart)
# Max photo translations per visitor (IP address) per rolling hour
IMAGE_RATE_LIMIT_PER_HOUR=6
# Max photo translations for the whole site per day (UTC). Set to 0 to pause photo translations.
IMAGE_DAILY_LIMIT=100

# Google Sheets API Configuration
# Place your service account JSON file in the project root
# and reference it here or set the content as an environment variable
GOOGLE_APPLICATION_CREDENTIALS=Form Translator DB IAM.json

# Production Configuration (for Fly.io)
# PORT=8080  # This will be set automatically by Fly.io




